# Docker Compose project and NAS process identity. Replace PUID/PGID with `id` output.
COMPOSE_PROJECT_NAME=cymediaflow
TZ=Asia/Shanghai
PUID=1000
PGID=1000

# NAS host paths. MEDIA_ROOT must be the real anime library; DATA_ROOT stores SQLite/cache.
MEDIA_ROOT=/volume1/media/Bangumi
MEDIA_MOUNT_MODE=rw
DATA_ROOT=/volume1/docker/CyMediaFlow/data

# Web entry. Prefer the NAS LAN address instead of 0.0.0.0 when practical.
APP_BIND_IP=0.0.0.0
APP_PORT=3000

# Initial provider/network defaults. Settings saved in the UI take precedence afterward.
CYMEDIAFLOW_BANGUMI_USER_AGENT=CyMediaFlow/0.1 (NAS administrator)
CYMEDIAFLOW_BANGUMI_PROXY_URL=http://192.168.5.124:20181
CYMEDIAFLOW_TMDB_PROXY_URL=

# NFO/image behavior.
CYMEDIAFLOW_OPERATION_MODE=nfo_managed_update
CYMEDIAFLOW_IGNORE_MARKER_ENABLED=true
# Comma-separated folder names or glob patterns. The UI stores one pattern per line.
CYMEDIAFLOW_IGNORE_FOLDER_PATTERNS=特典映像,映像特典,特典,对话,电话,電話,SP,PV,NCOP,NCED,NCOP&NCED,menu,menus,Fonts
